# Infrastructure / ports published on the host
POSTGRES_DB=pipemend
POSTGRES_USER=pipemend
POSTGRES_PASSWORD=pipemend
POSTGRES_HOST_PORT=5432
PIPELINE_HOST_PORT=8080
AI_HOST_PORT=8000

# Shared by both services (NFR-07)
AI_REQUEST_DEADLINE_SECONDS=25

# pipeline-service
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_CLIENT_CONNECT_TIMEOUT_MS=2000
AI_CLIENT_READ_TIMEOUT_MS=30000

# Correction policy thresholds (FR-09 / AC-09.4).
# The app fails to start if a threshold is < 0.5 or > 1. Changing a DEFAULT requires an ADR (docs/09 §2.1).
AI_MIN_CONFIDENCE=0.85
AI_ENUM_MIN_CONFIDENCE=0.90
AI_SCHEMA_MIN_CONFIDENCE=0.90

# Cost control and header mapping
AI_MAX_CALLS_PER_BATCH=500
AI_SCHEMA_SAMPLE_ROWS=100
AI_SCHEMA_MAX_INVALID_RATE=0.20

# Privacy of data sent to the LLM (NFR-15)
AI_REDACT_FIELDS=customer_id
AI_SEND_FULL_RECORD=true

# Ingestion and execution
PIPELINE_CHUNK_SIZE=100
PIPELINE_MAX_UPLOAD_MB=50

# NFR-10. The eclipse-temurin image does NOT read JAVA_OPTS on its own: JAVA_TOOL_OPTIONS is used instead.
JAVA_TOOL_OPTIONS=-Xmx512m

# ai-service
# mock = deterministic, no API key and no network (NFR-02). Alternatives: openai_compatible | anthropic.
LLM_PROVIDER=mock
LLM_MODEL=mock-rules-v1

# Leave empty with the mock provider. See docs/04 §9 to switch providers.
# BEFORE using a paid provider: set a spending limit in its console (NFR-11).
LLM_API_KEY=
LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=20
LLM_MAX_CALLS_PER_DAY=2000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0

# Versioned prompts: a published version is never edited; create v{n+1} instead (NFR-12)
PROMPT_VERSION_TRIAGE=triage_v1
PROMPT_VERSION_SCHEMA=schema_drift_v1

AI_EXPLANATION_LANGUAGE=es
TRIAGE_CACHE_MAX_ENTRIES=5000
TRIAGE_CACHE_TTL_SECONDS=86400
