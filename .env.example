# Infraestructura / puertos publicados en el host
POSTGRES_DB=pipemend
POSTGRES_USER=pipemend
POSTGRES_PASSWORD=pipemend
POSTGRES_HOST_PORT=5432
PIPELINE_HOST_PORT=8080
AI_HOST_PORT=8000

# Compartida por ambos servicios (NFR-07)
AI_REQUEST_DEADLINE_SECONDS=25

# pipeline-service
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_CLIENT_CONNECT_TIMEOUT_MS=2000
AI_CLIENT_READ_TIMEOUT_MS=30000

# Umbrales de la política de corrección (FR-09 / AC-09.4).
# La app no arranca si un umbral es < 0.5 o > 1. Cambiar un DEFAULT exige ADR (docs/09 §2.1).
AI_MIN_CONFIDENCE=0.85
AI_ENUM_MIN_CONFIDENCE=0.90
AI_SCHEMA_MIN_CONFIDENCE=0.90

# Control de costo y de mapeo de cabeceras
AI_MAX_CALLS_PER_BATCH=500
AI_SCHEMA_SAMPLE_ROWS=100
AI_SCHEMA_MAX_INVALID_RATE=0.20

# Privacidad de lo que viaja al LLM (NFR-15)
AI_REDACT_FIELDS=customer_id
AI_SEND_FULL_RECORD=true

# Ingesta y ejecución
PIPELINE_CHUNK_SIZE=100
PIPELINE_MAX_UPLOAD_MB=50

# NFR-10. La imagen eclipse-temurin NO lee JAVA_OPTS por sí sola: se usa JAVA_TOOL_OPTIONS.
JAVA_TOOL_OPTIONS=-Xmx512m

# ai-service
# mock = determinista, sin API key y sin red (NFR-02). Alternativas: openai_compatible | anthropic.
LLM_PROVIDER=mock
LLM_MODEL=mock-rules-v1

# Vacías con el proveedor mock. Ver docs/04 §9 para cambiar de proveedor.
# ANTES de usar un proveedor de pago: configura un límite de gasto en su consola (NFR-11).
LLM_API_KEY=
LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=20
LLM_MAX_CALLS_PER_DAY=2000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0

# Prompts versionados: una versión publicada nunca se edita, se crea v{n+1} (NFR-12)
PROMPT_VERSION_TRIAGE=triage_v1
PROMPT_VERSION_SCHEMA=schema_drift_v1

AI_EXPLANATION_LANGUAGE=es
TRIAGE_CACHE_MAX_ENTRIES=5000
TRIAGE_CACHE_TTL_SECONDS=86400
